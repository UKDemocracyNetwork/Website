{{!-- Overrides Ghost's {{pagination}} output, using the TetraLogical "Pagination"
     pattern. Ghost's helpers can't loop over page numbers, so this shows previous,
     the current position and next rather than a numbered list. --}}
{{#if pages}}
<nav class="pagination" aria-label="Pagination">
  {{#if prev}}
    <a class="button button--secondary" href="{{page_url prev}}" aria-label="Previous page">&lt;&nbsp;Previous</a>
  {{/if}}
  <p>Page {{page}} of {{pages}}</p>
  {{#if next}}
    <a class="button button--secondary" href="{{page_url next}}" aria-label="Next page">Next&nbsp;&gt;</a>
  {{/if}}
</nav>
{{/if}}
